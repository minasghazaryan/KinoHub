@page
@model KinoHub.Web.Pages.Admin.IndexModel
@using KinoHub.Web.Models
@{
    ViewData["Title"] = "Admin";
}

<section class="space-y-6">
    <h1 class="text-2xl font-semibold text-slate-50">Admin</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="@(Model.IsSuccess ? "bg-emerald-500/10 text-emerald-300 border-emerald-500/30" : "bg-amber-500/10 text-amber-300 border-amber-500/30") rounded-lg border px-4 py-3 text-sm">
            @Model.Message
        </div>
    }

    <div class="flex flex-col gap-6 lg:flex-row lg:gap-4">
        <div class="min-w-0 flex-1 rounded-xl border border-slate-800 bg-slate-900/60 p-6">
            <h2 class="text-sm font-semibold text-slate-200 mb-2">Kinopoisk API – Collections</h2>
            <p class="text-sm text-slate-400 mb-4">Fetch films from a collection (type + page). Each page has up to 20 films. <code class="rounded bg-slate-800 px-1.5 py-0.5 text-xs">KinopoiskApiKey</code> in appsettings.</p>
            <form method="post" asp-page-handler="SyncKinopoisk" class="mb-4">
                <button type="submit" class="rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-slate-900 hover:bg-amber-500 transition-colors">Sync TOP 250 (page 1)</button>
            </form>
            <form method="post" asp-page-handler="CheckCollectionPages" class="inline-block mb-4">
                <input type="hidden" name="collectionType" value="@Model.SelectedCollectionType" />
                <button type="submit" class="rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-sm font-medium text-slate-300 hover:bg-slate-700 transition-colors">Check page count</button>
            </form>
            <p class="text-xs text-slate-500 mb-3">@(Model.CollectionTotalPages > 0 ? $"This collection has {Model.CollectionTotalPages} page(s)." : "Click «Check page count» or sync to see total pages.")</p>
            <div class="flex flex-wrap items-end gap-3">
                <form method="post" asp-page-handler="SyncKinopoiskCollection" class="flex flex-wrap items-end gap-3">
                    <div>
                        <label class="block text-xs text-slate-500 mb-1">Collection type</label>
                        <select name="collectionType" class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 min-w-[220px]">
                            @foreach (var opt in KinopoiskCollectionType.All)
                            {
                                <option value="@opt.Value" selected="@(Model.SelectedCollectionType == opt.Value ? "selected" : null)">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <div class="flex items-end gap-1">
                        <div>
                            <label class="block text-xs text-slate-500 mb-1">Page</label>
                            <input type="number" name="page" value="@Model.CollectionPage" min="1" class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 w-20" />
                        </div>
                        <span class="pb-2 text-slate-500 text-sm">of @(Model.CollectionTotalPages > 0 ? Model.CollectionTotalPages.ToString() : "?")</span>
                    </div>
                    <button type="submit" class="rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-slate-900 hover:bg-amber-500 transition-colors">Sync collection</button>
                </form>
                <form method="post" asp-page-handler="SyncAllCollection" class="flex flex-wrap items-end gap-3">
                    <div>
                        <label class="block text-xs text-slate-500 mb-1">Collection type (for Sync all)</label>
                        <select name="collectionType" class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 min-w-[220px]">
                            @foreach (var opt in KinopoiskCollectionType.All)
                            {
                                <option value="@opt.Value" selected="@(Model.SelectedCollectionType == opt.Value ? "selected" : null)">@opt.Label</option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 text-sm font-medium text-white hover:bg-emerald-500 transition-colors" onclick="return confirm('Sync all pages of this collection? This may take a while.');">Sync all</button>
                </form>
                @if (Model.CollectionTotalPages > 0 && Model.CollectionPage > 1)
                {
                    <form method="post" asp-page-handler="SyncKinopoiskCollection" class="inline-flex">
                        <input type="hidden" name="collectionType" value="@Model.SelectedCollectionType" />
                        <input type="hidden" name="page" value="@(Model.CollectionPage - 1)" />
                        <button type="submit" class="rounded-lg border border-slate-600 bg-slate-800 px-2 py-2 text-sm text-slate-300 hover:bg-slate-700 transition-colors" title="Sync previous page">← Prev</button>
                    </form>
                }
                @if (Model.CollectionTotalPages > 0 && Model.CollectionPage < Model.CollectionTotalPages)
                {
                    <form method="post" asp-page-handler="SyncKinopoiskCollection" class="inline-flex">
                        <input type="hidden" name="collectionType" value="@Model.SelectedCollectionType" />
                        <input type="hidden" name="page" value="@(Model.CollectionPage + 1)" />
                        <button type="submit" class="rounded-lg border border-slate-600 bg-slate-800 px-2 py-2 text-sm text-slate-300 hover:bg-slate-700 transition-colors" title="Sync next page">Next →</button>
                    </form>
                }
            </div>
        </div>

        <div class="min-w-0 flex-1 rounded-xl border border-slate-800 bg-slate-900/60 p-6">
            <h2 class="text-sm font-semibold text-slate-200 mb-2">Кинопремьеры</h2>
        <p class="text-sm text-slate-400 mb-4">Browse new coming films from the premieres endpoint. Choose which to show on the Index page.</p>
        <form method="get" class="flex flex-wrap items-end gap-3 mb-4">
            <div>
                <label class="block text-xs text-slate-500 mb-1">Year</label>
                <select name="premieresYear" class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 w-24">
                    @for (var y = DateTime.UtcNow.Year; y <= DateTime.UtcNow.Year + 1; y++)
                    {
                        <option value="@y" selected="@(Model.PremieresYear == y)">@y</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs text-slate-500 mb-1">Month</label>
                <select name="premieresMonth" class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 min-w-[140px]">
                    @{ var monthsRu = new[] { "Январь", "Февраль", "Март", "Апрель", "Май", "Июнь", "Июль", "Август", "Сентябрь", "Октябрь", "Ноябрь", "Декабрь" }; }
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(Model.PremieresMonth == m)">@monthsRu[m - 1]</option>
                    }
                </select>
            </div>
            <button type="submit" class="rounded-lg bg-slate-600 px-4 py-2 text-sm font-medium text-white hover:bg-slate-500 transition-colors">Load</button>
        </form>
        @if (Model.ApiPremieres.Count > 0)
        {
            <div class="grid grid-cols-3 sm:grid-cols-4 lg:grid-cols-5 gap-2 max-h-[400px] overflow-y-auto">
                @foreach (var item in Model.ApiPremieres)
                {
                    var title = !string.IsNullOrWhiteSpace(item.NameRu) ? item.NameRu : (item.NameEn ?? "");
                    var posterUrl = !string.IsNullOrEmpty(item.PosterUrlPreview) ? item.PosterUrlPreview : item.PosterUrl;
                    if (!string.IsNullOrEmpty(posterUrl) && !posterUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)) { posterUrl = "https://kinopoiskapiunofficial.tech" + posterUrl; }
                    var onIndex = Model.FeaturedKinopoiskIds.Contains(item.KinopoiskId);
                    var genresText = item.Genres != null && item.Genres.Count > 0 ? string.Join(", ", item.Genres.Select(g => g.Genre).Where(g => !string.IsNullOrEmpty(g))) : "";
                    var durationText = item.Duration.HasValue && item.Duration.Value > 0 ? item.Duration.Value + " мин" : "";
                    <div class="rounded-lg border border-slate-700/80 bg-slate-800/60 overflow-hidden flex flex-col">
                        <div class="relative aspect-[2/3] bg-slate-700 min-h-0">
                            @if (!string.IsNullOrEmpty(posterUrl))
                            {
                                <img src="@posterUrl" alt="" class="h-full w-full object-cover" />
                            }
                            else
                            {
                                <div class="h-full w-full flex items-center justify-center text-slate-500 text-xs">Нет постера</div>
                            }
                        </div>
                        <div class="p-1.5 flex-1 flex flex-col min-w-0">
                            <p class="text-xs font-medium text-slate-200 line-clamp-2" title="@title">@title</p>
                            @if (!string.IsNullOrEmpty(genresText))
                            {
                                <p class="text-[10px] text-slate-500 mt-0.5 line-clamp-1">@genresText</p>
                            }
                            <div class="flex flex-wrap items-center gap-x-1 mt-0.5 text-[10px] text-slate-500">
                                @if (item.Year.HasValue) { <span>@item.Year</span> }
                                @if (!string.IsNullOrEmpty(durationText)) { <span>@durationText</span> }
                                @if (!string.IsNullOrEmpty(item.PremiereRu)) { <span>@item.PremiereRu</span> }
                            </div>
                            <div class="mt-1">
                                @if (onIndex)
                                {
                                    <span class="text-xs text-amber-400">On index</span>
                                    <form method="post" asp-page-handler="RemoveFeaturedPremiere" class="inline">
                                        <input type="hidden" name="id" value="@Model.FeaturedPremieres.First(f => f.KinopoiskId == item.KinopoiskId).Id" />
                                        <input type="hidden" name="premieresYear" value="@Model.PremieresYear" />
                                        <input type="hidden" name="premieresMonth" value="@Model.PremieresMonth" />
                                        <button type="submit" class="rounded px-1.5 py-0.5 text-[10px] text-slate-400 hover:bg-red-500/20 hover:text-red-300">Remove</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="AddFeaturedPremiereFromApi">
                                        <input type="hidden" name="kinopoiskId" value="@item.KinopoiskId" />
                                        <input type="hidden" name="nameRu" value="@item.NameRu" />
                                        <input type="hidden" name="nameEn" value="@item.NameEn" />
                                        <input type="hidden" name="posterUrl" value="@(item.PosterUrlPreview ?? item.PosterUrl)" />
                                        <input type="hidden" name="year" value="@item.Year" />
                                        <input type="hidden" name="premiereRu" value="@item.PremiereRu" />
                                        <input type="hidden" name="premieresYear" value="@Model.PremieresYear" />
                                        <input type="hidden" name="premieresMonth" value="@Model.PremieresMonth" />
                                        <button type="submit" class="rounded bg-amber-600 px-1.5 py-0.5 text-[10px] font-medium text-slate-900 hover:bg-amber-500 transition-colors w-full">Add to index</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-sm text-slate-500">No premieres for this month with year @Model.PremieresYear, or API error. Select year/month and click Load.</p>
        }
            </div>
    </div>

    <div class="flex flex-col gap-4 lg:flex-row lg:gap-4">
        <div class="min-w-0 flex-1 rounded-xl border border-slate-800 bg-slate-900/60 p-6">
            <h2 class="text-sm font-semibold text-slate-200 mb-2">Подборка (главная)</h2>
            <p class="text-xs text-slate-400 mb-3">Search and add films to the «Подборка» carousel on the Index page.</p>
            <form method="post" asp-page-handler="SearchCarousel" class="flex flex-wrap items-end gap-2 mb-4">
                <div class="min-w-0 flex-1">
                    <label class="block text-xs text-slate-500 mb-1">Search</label>
                    <input type="text" name="carouselSearch" value="@Model.CarouselSearchQuery" placeholder="Название фильма..." class="w-full rounded-lg border border-slate-700 bg-slate-800 px-3 py-2 text-slate-100 min-w-[200px]" />
                </div>
                <button type="submit" class="rounded-lg bg-slate-600 px-4 py-2 text-sm font-medium text-white hover:bg-slate-500 transition-colors">Search</button>
            </form>
            @if (Model.CarouselSearchResult != null)
            {
                var films = Model.CarouselSearchResult.Films;
                if (films.Count > 0)
                {
                    <p class="text-xs text-slate-500 mb-2">Found @films.Count — add to Подборка:</p>
                    <ul class="space-y-2 max-h-[220px] overflow-y-auto mb-4">
                        @foreach (var f in films)
                        {
                            var title = !string.IsNullOrWhiteSpace(f.NameRu) ? f.NameRu : (f.NameEn ?? "");
                            var posterUrl = f.PosterUrlPreview ?? f.PosterUrl;
                            if (!string.IsNullOrEmpty(posterUrl) && !posterUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase)) { posterUrl = "https://kinopoiskapiunofficial.tech" + (posterUrl.StartsWith("/") ? posterUrl : "/" + posterUrl); }
                            var inCarousel = Model.CarouselKinopoiskIds.Contains(f.FilmId);
                            <li class="flex items-center gap-2 rounded border border-slate-700/80 bg-slate-800/60 p-2">
                                @if (!string.IsNullOrEmpty(posterUrl))
                                {
                                    <img src="@posterUrl" alt="" class="h-10 w-7 shrink-0 rounded object-cover" />
                                }
                                <span class="min-w-0 flex-1 text-sm text-slate-200 truncate" title="@title">@title</span>
                                @if (!string.IsNullOrEmpty(f.Year)) { <span class="text-xs text-slate-500">@f.Year</span> }
                                @if (inCarousel)
                                {
                                    <span class="text-xs text-amber-400">In Подборка</span>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="AddToCarousel" class="shrink-0">
                                        <input type="hidden" name="kinopoiskId" value="@f.FilmId" />
                                        <input type="hidden" name="nameRu" value="@f.NameRu" />
                                        <input type="hidden" name="nameEn" value="@f.NameEn" />
                                        <input type="hidden" name="posterUrl" value="@(f.PosterUrlPreview ?? f.PosterUrl)" />
                                        <input type="hidden" name="year" value="@f.Year" />
                                        <input type="hidden" name="rating" value="@f.Rating" />
                                        <button type="submit" class="rounded bg-amber-600 px-2 py-1 text-xs font-medium text-slate-900 hover:bg-amber-500">Add to Подборка</button>
                                    </form>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-sm text-slate-500 mb-4">No results for «@Model.CarouselSearchQuery».</p>
                }
            }
            @if (Model.FeaturedCarousels.Count > 0)
            {
                <p class="text-xs text-slate-500 mb-2">Current Подборка (reorder with ↑/↓):</p>
                <ul class="space-y-1 max-h-[180px] overflow-y-auto">
                    @foreach (var c in Model.FeaturedCarousels)
                    {
                        var title = !string.IsNullOrWhiteSpace(c.NameRu) ? c.NameRu : (c.NameEn ?? "");
                        <li class="flex items-center gap-2 rounded border border-slate-700/80 bg-slate-800/60 px-2 py-1.5">
                            <div class="flex gap-0.5 shrink-0">
                                <form method="post" asp-page-handler="MoveCarouselItem" class="inline">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <input type="hidden" name="direction" value="up" />
                                    <button type="submit" class="rounded p-0.5 text-slate-400 hover:bg-slate-700 hover:text-white text-xs">↑</button>
                                </form>
                                <form method="post" asp-page-handler="MoveCarouselItem" class="inline">
                                    <input type="hidden" name="id" value="@c.Id" />
                                    <input type="hidden" name="direction" value="down" />
                                    <button type="submit" class="rounded p-0.5 text-slate-400 hover:bg-slate-700 hover:text-white text-xs">↓</button>
                                </form>
                            </div>
                            <span class="min-w-0 flex-1 text-sm text-slate-200 truncate">@title</span>
                            <form method="post" asp-page-handler="RemoveCarouselItem" class="shrink-0" onsubmit="return confirm('Remove from Подборка?');">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="rounded px-1.5 py-0.5 text-xs text-slate-400 hover:bg-red-500/20 hover:text-red-300">Remove</button>
                            </form>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="text-sm text-slate-500">No films in Подборка yet. Search above and add. If empty, the Index page shows top movies from the catalog.</p>
            }
        </div>

        <div class="min-w-0 flex-1 rounded-xl border border-slate-800 bg-slate-900/60 p-6">
            <h2 class="text-sm font-semibold text-slate-200 mb-2">На главной (Кинопремьеры)</h2>
            <p class="text-sm text-slate-400 mb-4">Films shown in the «Кинопремьеры» section on the Index page. Add from «Кинопремьеры» above; reorder with ↑/↓.</p>
        @if (Model.FeaturedPremieres.Count > 0)
        {
            <ul class="space-y-2">
                @foreach (var f in Model.FeaturedPremieres)
                {
                    var title = !string.IsNullOrWhiteSpace(f.NameRu) ? f.NameRu : (f.NameEn ?? $"ID {f.KinopoiskId}");
                    var posterUrl = !string.IsNullOrEmpty(f.PosterUrl) ? (f.PosterUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? f.PosterUrl : "https://kinopoiskapiunofficial.tech" + f.PosterUrl) : null;
                    <li class="flex items-center gap-3 rounded-lg border border-slate-700/80 bg-slate-800/60 p-2">
                        <div class="flex gap-1 shrink-0">
                            <form method="post" asp-page-handler="MoveFeaturedPremiere" class="inline">
                                <input type="hidden" name="id" value="@f.Id" />
                                <input type="hidden" name="direction" value="up" />
                                <input type="hidden" name="premieresYear" value="@Model.PremieresYear" />
                                <input type="hidden" name="premieresMonth" value="@Model.PremieresMonth" />
                                <button type="submit" class="rounded p-1 text-slate-400 hover:bg-slate-700 hover:text-white" title="Up">↑</button>
                            </form>
                            <form method="post" asp-page-handler="MoveFeaturedPremiere" class="inline">
                                <input type="hidden" name="id" value="@f.Id" />
                                <input type="hidden" name="direction" value="down" />
                                <input type="hidden" name="premieresYear" value="@Model.PremieresYear" />
                                <input type="hidden" name="premieresMonth" value="@Model.PremieresMonth" />
                                <button type="submit" class="rounded p-1 text-slate-400 hover:bg-slate-700 hover:text-white" title="Down">↓</button>
                            </form>
                        </div>
                        @if (!string.IsNullOrEmpty(posterUrl))
                        {
                            <img src="@posterUrl" alt="" class="h-12 w-8 shrink-0 rounded object-cover" />
                        }
                        else
                        {
                            <div class="h-12 w-8 shrink-0 rounded bg-slate-700 flex items-center justify-center text-slate-500 text-xs">—</div>
                        }
                        <span class="min-w-0 flex-1 text-sm text-slate-200 truncate" title="@title">@title</span>
                        @if (f.Year.HasValue) { <span class="text-xs text-slate-500 shrink-0">@f.Year</span> }
                        <form method="post" asp-page-handler="RemoveFeaturedPremiere" class="shrink-0" onsubmit="return confirm('Remove from Кинопремьеры?');">
                            <input type="hidden" name="id" value="@f.Id" />
                            <input type="hidden" name="premieresYear" value="@Model.PremieresYear" />
                            <input type="hidden" name="premieresMonth" value="@Model.PremieresMonth" />
                            <button type="submit" class="rounded px-2 py-1 text-xs text-slate-400 hover:bg-red-500/20 hover:text-red-300">Remove</button>
                        </form>
                    </li>
                }
            </ul>
        }
        else
        {
            <p class="text-sm text-slate-500">No films yet. Add from «Кинопремьеры» above.</p>
        }
        </div>
    </div>
</section>
