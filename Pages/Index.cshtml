@page
@model KinoHub.Web.Pages.IndexModel
@{
    ViewData["Title"] = Model.SearchResult != null ? "Поиск" : (Model.FiltersResult != null ? "Каталог" : (Model.CollectionResult != null ? "Подборка" : "Главная"));
    ViewData["SearchQuery"] = Model.SearchQuery;
    ViewData["Collection"] = Model.Collection;
    string PosterUrl(string path) => string.IsNullOrEmpty(path) ? "" : (path.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? path : "https://image.tmdb.org/t/p/w500" + path);
    string CarouselPosterUrl(string path) => string.IsNullOrEmpty(path) ? "" : (path.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? path : "https://image.tmdb.org/t/p/w500" + path);
    string CarouselTitle(KinoHub.Web.Pages.CarouselItem i) => !string.IsNullOrWhiteSpace(i.NameRu) ? i.NameRu : i.Title;
    string SearchFilmTitle(KinoHub.Web.Models.KinopoiskSearchFilmDto f) => !string.IsNullOrWhiteSpace(f.NameRu) ? f.NameRu : (f.NameEn ?? "");
    string CollectionItemTitle(KinoHub.Web.Models.KinopoiskFilmItemDto i) => !string.IsNullOrWhiteSpace(i.NameRu) ? i.NameRu : (i.NameEn ?? i.NameOriginal ?? "");
    string YearStr(KinoHub.Web.Models.KinopoiskFilmItemDto i) => i.Year.HasValue ? i.Year.Value.ToString() : "";
    string CountriesStr(KinoHub.Web.Models.KinopoiskFilmItemDto i) => i.Countries != null && i.Countries.Count > 0 ? string.Join(", ", i.Countries.Select(c => c.Country).Where(c => !string.IsNullOrEmpty(c))) : "";
    string GenresStr(KinoHub.Web.Models.KinopoiskFilmItemDto i) => i.Genres != null && i.Genres.Count > 0 ? string.Join(" / ", i.Genres.Select(g => g.Genre).Where(g => !string.IsNullOrEmpty(g))) : "";
    string PremierePosterUrl(string? url) => string.IsNullOrEmpty(url) ? "" : (url.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? url : "https://kinopoiskapiunofficial.tech" + url);
    string FeaturedTitle(KinoHub.Web.Models.KinopoiskPremiereItemDto i) => !string.IsNullOrWhiteSpace(i.NameRu) ? i.NameRu : (i.NameEn ?? "");
    var _ru = System.Globalization.CultureInfo.GetCultureInfo("ru-RU");
    string Capitalize(string? s) => string.IsNullOrEmpty(s) ? "" : char.ToUpper(s[0], _ru) + s.Substring(1);
}

<div class="mx-auto max-w-7xl">
    @* Top: carousel on all tabs (main, novinki, seriali, top 250, catalog) — not on Admin *@
    <section class="px-3 py-4 sm:px-4 sm:py-6">
            <h2 class="mb-3 text-base font-semibold text-slate-200 sm:mb-4 sm:text-lg">Подборка</h2>
            @if (Model.CarouselItems.Count == 0)
            {
                <div class="flex items-center justify-center rounded-xl border border-slate-800 bg-slate-900/60 py-16">
                    <p class="text-slate-400">Нет фильмов. Каталог ещё не заполнен.</p>
                </div>
            }
            else
            {
                <div class="relative -mx-4 flex items-center">
                    <button type="button" aria-label="Назад" class="carousel-prev absolute left-0 z-10 flex h-14 w-10 shrink-0 items-center justify-center rounded-r-lg bg-slate-900/90 text-white shadow-lg transition hover:bg-amber-600 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
                    </button>
                    <div id="carousel-main" class="min-w-0 flex-1 flex overflow-x-auto overflow-y-hidden px-2 py-2 overscroll-x-contain" style="scrollbar-width: none; -ms-overflow-style: none;">
                        @{ var carouselItems = Model.CarouselItems.Take(20).ToList(); }
                        @for (var copy = 0; copy < 2; copy++)
                        {
                            <div class="carousel-set flex shrink-0 gap-4">
                                @foreach (var item in carouselItems)
                                {
                                    <a href="@Model.GetMovieUrlByKinopoiskId(item.KinopoiskId)" class="group flex w-28 shrink-0 flex-col sm:w-32 transition-transform hover:scale-[1.02]">
                                        <div class="relative aspect-[2/3] w-full overflow-hidden rounded-lg bg-slate-800 shadow-lg">
                                            @if (!string.IsNullOrEmpty(item.PosterPath))
                                            {
                                                <img src="@CarouselPosterUrl(item.PosterPath)" alt="@CarouselTitle(item)" class="h-full w-full object-cover transition group-hover:brightness-110" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="flex h-full w-full items-center justify-center text-slate-500 text-xs">Нет постера</div>
                                            }
                                            @if (item.Rating.HasValue)
                                            {
                                                <span class="absolute right-1.5 top-1.5 rounded bg-slate-900/80 px-1.5 py-0.5 text-xs font-medium text-amber-400">★ @item.Rating.Value.ToString("F1")</span>
                                            }
                                        </div>
                                        <div class="mt-1.5 flex h-14 flex-col justify-center">
                                            <p class="line-clamp-2 text-center text-sm font-medium text-slate-200 group-hover:text-amber-200">@CarouselTitle(item)</p>
                                            @if (!string.IsNullOrEmpty(item.ReleaseYear))
                                            {
                                                <p class="text-center text-xs text-slate-500">@item.ReleaseYear</p>
                                            }
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                    <button type="button" aria-label="Вперёд" class="carousel-next absolute right-0 z-10 flex h-14 w-10 shrink-0 items-center justify-center rounded-l-lg bg-slate-900/90 text-white shadow-lg transition hover:bg-amber-600 hover:text-slate-900 focus:outline-none focus:ring-2 focus:ring-amber-500">
                        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                    </button>
                </div>
                <style>
                    #carousel-main::-webkit-scrollbar { display: none; }
                </style>
                <script>
                    (function () {
                        var el = document.getElementById('carousel-main');
                        if (!el) return;
                        function getStep() {
                            var set = el.querySelector('.carousel-set');
                            var first = set && set.firstElementChild;
                            return first ? first.offsetWidth + 16 : 144;
                        }
                        function getSetWidth() {
                            var set = el.querySelector('.carousel-set');
                            return set ? set.offsetWidth : el.scrollWidth / 2;
                        }
                        function loopScroll() {
                            var setWidth = getSetWidth();
                            if (setWidth <= 0) return;
                            if (el.scrollLeft >= setWidth - 1) {
                                el.scrollLeft = el.scrollLeft - setWidth;
                            }
                        }
                        el.addEventListener('scroll', function () {
                            requestAnimationFrame(loopScroll);
                        }, { passive: true });
                        document.querySelector('.carousel-prev')?.addEventListener('click', function () {
                            var setWidth = getSetWidth();
                            if (el.scrollLeft <= 5) el.scrollLeft = setWidth - el.clientWidth;
                            el.scrollBy({ left: -getStep(), behavior: 'smooth' });
                        });
                        document.querySelector('.carousel-next')?.addEventListener('click', function () {
                            var setWidth = getSetWidth();
                            if (el.scrollLeft >= setWidth - el.clientWidth - 5) el.scrollLeft = 0;
                            el.scrollBy({ left: getStep(), behavior: 'smooth' });
                        });
                    })();
                </script>
            }
        </section>

    @* Always: sidebar + main content div (data loads here) *@
    <section class="flex flex-col gap-6 border-t border-slate-800 px-3 py-4 sm:px-4 sm:py-6 lg:flex-row" style="padding-top:15px">
        <aside class="w-full shrink-0 lg:w-[250px]">
            <h3 class="mb-3 text-sm font-bold text-white sm:mb-4">Навигация</h3>
            <div class="flex flex-col gap-4 sm:gap-6">
                <div class="flex flex-col gap-4 sm:flex-row sm:gap-6">
                    <div class="min-w-0 flex-1">
                        <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">Жанры</p>
                        @{ var genresList = Model.Genres.ToList(); var genresFirst = genresList.Take(8).ToList(); var genresRest = genresList.Skip(8).ToList(); }
                        <ul class="space-y-1 text-sm">
                            @foreach (var g in genresFirst)
                            {
                                <li><a asp-page="/Index" asp-route-genreId="@g.Id" class="text-slate-300 underline decoration-slate-600 underline-offset-2 hover:text-amber-400 hover:decoration-amber-400 @(Model.GenreId == g.Id ? "text-amber-400 font-medium" : "")">@Capitalize(g.Name)</a></li>
                            }
                        </ul>
                        @if (genresRest.Count > 0)
                        {
                            <div id="nav-genres-more" class="hidden">
                                <ul class="mt-1 space-y-1 text-sm">
                                    @foreach (var g in genresRest)
                                    {
                                        <li><a asp-page="/Index" asp-route-genreId="@g.Id" class="text-slate-300 underline decoration-slate-600 underline-offset-2 hover:text-amber-400 hover:decoration-amber-400 @(Model.GenreId == g.Id ? "text-amber-400 font-medium" : "")">@Capitalize(g.Name)</a></li>
                                    }
                                </ul>
                            </div>
                            <button type="button" class="nav-load-more mt-1 text-xs text-amber-400 hover:text-amber-300" data-target="nav-genres-more">Показать ещё (@genresRest.Count)</button>
                        }
                    </div>
                    <div class="min-w-0 flex-1 flex flex-col gap-4">
                        <div>
                            <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">По году</p>
                            @{ var years = new List<int>(); for (var y = DateTime.UtcNow.Year; y >= DateTime.UtcNow.Year - 11; y--) { years.Add(y); } var yearsFirst = years.Take(6).ToList(); var yearsRest = years.Skip(6).ToList(); }
                            <ul class="space-y-1 text-sm">
                                @foreach (var y in yearsFirst)
                                {
                                    <li><a asp-page="/Index" asp-route-year="@y" class="text-slate-300 underline decoration-slate-600 underline-offset-2 hover:text-amber-400 hover:decoration-amber-400 @(Model.Year == y ? "text-amber-400 font-medium" : "")">@y года</a></li>
                                }
                            </ul>
                            @if (yearsRest.Count > 0)
                            {
                                <div id="nav-years-more" class="hidden">
                                    <ul class="mt-1 space-y-1 text-sm">
                                        @foreach (var y in yearsRest)
                                        {
                                            <li><a asp-page="/Index" asp-route-year="@y" class="text-slate-300 underline decoration-slate-600 underline-offset-2 hover:text-amber-400 hover:decoration-amber-400 @(Model.Year == y ? "text-amber-400 font-medium" : "")">@y года</a></li>
                                        }
                                    </ul>
                                </div>
                                <button type="button" class="nav-load-more mt-1 text-xs text-amber-400 hover:text-amber-300" data-target="nav-years-more">Показать ещё (@yearsRest.Count)</button>
                            }
                        </div>
                        <div class="border-t border-slate-700 pt-4">
                            <p class="mb-2 text-xs font-semibold uppercase tracking-wider text-slate-400">По странам</p>
                            @{
                                var countryNav = new[] { ("Американские", "США"), ("Британские", "Великобритания"), ("Российские", "Россия"), ("Индийские", "Индия"), ("Немецкие", "Германия"), ("Французские", "Франция"), ("Казахстанские", "Казахстан"), ("Украинские", "Украина") };
                                var countryList = new List<(int id, string label)>();
                                foreach (var pair in countryNav)
                                {
                                    var match = Model.Countries.FirstOrDefault(c => c.Name != null && string.Equals(c.Name, pair.Item2, StringComparison.OrdinalIgnoreCase));
                                    if (match != null) { countryList.Add((match.Id, pair.Item1)); }
                                }
                                var countriesFirst = countryList.Take(4).ToList();
                                var countriesRest = countryList.Skip(4).ToList();
                            }
                            <ul class="space-y-1 text-sm">
                                @foreach (var t in countriesFirst)
                                {
                                    <li><a asp-page="/Index" asp-route-countryId="@t.id" class="text-slate-300 underline decoration-slate-600 underline-offset-2 hover:text-amber-400 hover:decoration-amber-400 @(Model.CountryId == t.id ? "text-amber-400 font-medium" : "")">@t.label</a></li>
                                }
                            </ul>
                            @if (countriesRest.Count > 0)
                            {
                                <div id="nav-countries-more" class="hidden">
                                    <ul class="mt-1 space-y-1 text-sm">
                                        @foreach (var t in countriesRest)
                                        {
                                            <li><a asp-page="/Index" asp-route-countryId="@t.id" class="text-slate-300 underline decoration-slate-600 underline-offset-2 hover:text-amber-400 hover:decoration-amber-400 @(Model.CountryId == t.id ? "text-amber-400 font-medium" : "")">@t.label</a></li>
                                        }
                                    </ul>
                                </div>
                                <button type="button" class="nav-load-more mt-1 text-xs text-amber-400 hover:text-amber-300" data-target="nav-countries-more">Показать ещё (@countriesRest.Count)</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
            <script>
                (function () {
                    document.querySelectorAll('.nav-load-more').forEach(function (btn) {
                        btn.addEventListener('click', function () {
                            var id = this.getAttribute('data-target');
                            var el = document.getElementById(id);
                            if (el) { el.classList.remove('hidden'); this.classList.add('hidden'); }
                        });
                    });
                })();
            </script>
        </aside>
        <div class="min-w-0 max-w-4xl flex-1 px-0 md:ml-6 md:px-0" id="main-content">
            <form id="catalog-filters-form" method="get" class="mb-4 flex flex-nowrap items-center gap-2 overflow-x-auto pb-1">
                <input type="hidden" name="filtersPage" value="1" />
                @if (Model.Collection != null) { <input type="hidden" name="collection" value="@Model.Collection" /> }
                @if (Model.CountryId.HasValue) { <input type="hidden" name="countryId" value="@Model.CountryId" /> }
                <span class="text-sm text-slate-400 shrink-0">Сортировка:</span>
                <select name="order" class="rounded border border-slate-700 bg-slate-800 px-2 py-1.5 text-sm text-slate-200 focus:border-amber-500 focus:outline-none shrink-0">
                    <option value="RATING" selected="@(Model.Order == "RATING")">по рейтингу</option>
                    <option value="NUM_VOTE" selected="@(Model.Order == "NUM_VOTE")">по голосам</option>
                    <option value="YEAR_DESC" selected="@(Model.Order == "YEAR_DESC")">по году (сначала новые)</option>
                    <option value="YEAR_ASC" selected="@(Model.Order == "YEAR_ASC")">по году (сначала старые)</option>
                </select>
                <select name="type" class="rounded border border-slate-700 bg-slate-800 px-2 py-1.5 text-sm text-slate-200 focus:border-amber-500 focus:outline-none shrink-0">
                    <option value="ALL" selected="@(Model.Type == "ALL")">Все</option>
                    <option value="FILM" selected="@(Model.Type == "FILM")">Фильм</option>
                    <option value="TV_SHOW" selected="@(Model.Type == "TV_SHOW")">ТВ-шоу</option>
                    <option value="TV_SERIES" selected="@(Model.Type == "TV_SERIES")">Сериал</option>
                    <option value="MINI_SERIES" selected="@(Model.Type == "MINI_SERIES")">Мини-сериал</option>
                </select>
                <select name="year" class="rounded border border-slate-700 bg-slate-800 px-2 py-1.5 text-sm text-slate-200 focus:border-amber-500 focus:outline-none shrink-0">
                    <option value="">Все годы</option>
                    @for (var y = DateTime.UtcNow.Year; y >= 1980; y--)
                    {
                        if (Model.Year == y)
                        {
                            <option value="@y" selected>@y</option>
                        }
                        else
                        {
                            <option value="@y">@y</option>
                        }
                    }
                </select>
                <select name="genreId" class="rounded border border-slate-700 bg-slate-800 px-2 py-1.5 text-sm text-slate-200 focus:border-amber-500 focus:outline-none shrink-0 min-w-0 max-w-[140px] sm:max-w-[160px]">
                    <option value="">Все жанры</option>
                    @foreach (var g in Model.Genres)
                    {
                        <option value="@g.Id" selected="@(Model.GenreId == g.Id)">@Capitalize(g.Name)</option>
                    }
                </select>
            </form>
            <script>
                (function () {
                    var form = document.getElementById('catalog-filters-form');
                    if (!form) return;
                    form.querySelectorAll('select').forEach(function (sel) {
                        sel.addEventListener('change', function () { form.submit(); });
                    });
                })();
            </script>

            @if (Model.SearchResult != null)
            {
                <h2 class="mb-2 text-lg font-semibold text-slate-200">Результаты поиска: «@Model.SearchResult.Keyword»</h2>
                <p class="mb-4 text-sm text-slate-400">Найдено: @Model.SearchResult.SearchFilmsCountResult, страница @Model.SearchResult.Page из @(Model.SearchResult.PagesCount == 0 ? 1 : Model.SearchResult.PagesCount)</p>
                @if (Model.SearchResult.Films.Count == 0)
                {
                    <p class="text-slate-400">Ничего не найдено. Попробуйте другой запрос.</p>
                }
                else
                {
                    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4">
                        @foreach (var film in Model.SearchResult.Films)
                        {
                            <a href="@Model.GetMovieUrlByKinopoiskId(film.FilmId)" class="group flex flex-col">
                                <div class="relative aspect-[2/3] overflow-hidden rounded-lg bg-slate-800 shadow-lg">
                                    @if (!string.IsNullOrEmpty(film.PosterUrl) || !string.IsNullOrEmpty(film.PosterUrlPreview))
                                    {
                                        <img src="@PosterUrl(film.PosterUrl ?? film.PosterUrlPreview ?? "")" alt="@SearchFilmTitle(film)" class="h-full w-full object-cover transition group-hover:brightness-110" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="flex h-full w-full items-center justify-center text-slate-500 text-xs">Нет постера</div>
                                    }
                                    @if (!string.IsNullOrEmpty(film.Rating))
                                    {
                                        <span class="absolute right-1.5 top-1.5 rounded bg-slate-900/80 px-1.5 py-0.5 text-xs font-medium text-amber-400">@film.Rating</span>
                                    }
                                </div>
                                <p class="mt-1.5 line-clamp-2 text-sm font-medium text-slate-200 group-hover:text-amber-200">@SearchFilmTitle(film)</p>
                                <p class="text-xs text-slate-500">@film.Year @(film.FilmLength != null ? "· " + film.FilmLength : "")</p>
                            </a>
                        }
                    </div>
                    @if (Model.SearchResult.PagesCount > 1)
                    {
                        <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
                            @if (Model.SearchPage > 1)
                            {
                                <a asp-page="/Index" asp-route-q="@Model.SearchQuery" asp-route-page="@(Model.SearchPage - 1)" class="rounded bg-slate-800 px-3 py-1.5 text-sm text-slate-300 hover:bg-amber-600 hover:text-slate-900">← Назад</a>
                            }
                            <span class="px-3 py-1.5 text-sm text-slate-400">@Model.SearchPage / @Model.SearchResult.PagesCount</span>
                            @if (Model.SearchPage < Model.SearchResult.PagesCount)
                            {
                                <a asp-page="/Index" asp-route-q="@Model.SearchQuery" asp-route-page="@(Model.SearchPage + 1)" class="rounded bg-slate-800 px-3 py-1.5 text-sm text-slate-300 hover:bg-amber-600 hover:text-slate-900">Вперёд →</a>
                            }
                        </div>
                    }
                }
            }
            else if (Model.FiltersResult != null)
            {
                <h2 class="mb-2 text-lg font-semibold text-slate-200">Каталог</h2>
                <p class="mb-4 text-sm text-slate-400">Найдено: @Model.FiltersResult.Total · страница @Model.FiltersResult.Page из @(Model.FiltersResult.TotalPages == 0 ? 1 : Model.FiltersResult.TotalPages)</p>
                @if (Model.FiltersResult.Items.Count == 0)
                {
                    <p class="text-slate-400">Ничего не найдено. Измените фильтры.</p>
                }
                else
                {
                    <ul class="max-w-2xl space-y-4">
                        @foreach (var item in Model.FiltersResult.Items)
                        {
                            <li class="flex gap-3 rounded-xl border border-slate-800 bg-slate-900/60 p-3">
                                <div class="w-28 shrink-0 sm:w-36">
                                    <a href="@Model.GetMovieUrlByKinopoiskId(item.KinopoiskId)" class="block">
                                        <div class="relative aspect-[2/3] overflow-hidden rounded-lg bg-slate-800">
                                            @if (!string.IsNullOrEmpty(item.PosterUrl) || !string.IsNullOrEmpty(item.PosterUrlPreview))
                                            {
                                                <img src="@PosterUrl(item.PosterUrl ?? item.PosterUrlPreview ?? "")" alt="@CollectionItemTitle(item)" class="h-full w-full object-cover transition hover:brightness-110" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="flex h-full w-full items-center justify-center text-slate-500 text-xs">Нет постера</div>
                                            }
                                            @if (item.Type == "TV_SERIES" || (item.Type != null && item.Type.Contains("SERIES", StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <span class="absolute bottom-0 left-0 right-0 bg-slate-900/90 px-2 py-1 text-center text-xs text-amber-300">Сериал</span>
                                            }
                                        </div>
                                    </a>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <a href="@Model.GetMovieUrlByKinopoiskId(item.KinopoiskId)" class="hover:text-amber-300">
                                        <h3 class="text-base font-semibold text-slate-100">@CollectionItemTitle(item) @(YearStr(item) != "" ? "(" + YearStr(item) + ")" : "")</h3>
                                    </a>
                                    <p class="mt-0.5 flex items-center gap-2 text-sm text-amber-400">
                                        <span>★</span>
                                        <span>@item.RatingKinopoisk.ToString("F1")</span>
                                        <span class="text-slate-500">/ 10</span>
                                    </p>
                                    <dl class="mt-2 grid gap-1 text-sm sm:grid-cols-1">
                                        @if (YearStr(item) != "")
                                        {
                                            <div class="flex gap-2"><dt class="text-slate-500 shrink-0">Год:</dt><dd class="text-slate-300">@YearStr(item)</dd></div>
                                        }
                                        @if (CountriesStr(item) != "")
                                        {
                                            <div class="flex gap-2"><dt class="text-slate-500 shrink-0">Страна:</dt><dd class="text-slate-300">@CountriesStr(item)</dd></div>
                                        }
                                        @if (GenresStr(item) != "")
                                        {
                                            <div class="flex gap-2"><dt class="text-slate-500 shrink-0">Жанр:</dt><dd class="text-slate-300">@GenresStr(item)</dd></div>
                                        }
                                    </dl>
                                    <div class="mt-3">
                                        <a href="@Model.GetMovieUrlByKinopoiskId(item.KinopoiskId)" class="inline-block rounded-lg bg-amber-600 px-3 py-1.5 text-sm font-medium text-slate-900 hover:bg-amber-500">Смотреть онлайн</a>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                    @if (Model.FiltersResult.TotalPages > 1)
                    {
                        <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
                            @if (Model.FiltersResult.Page > 1)
                            {
                                <a asp-page="/Index" asp-route-collection="@Model.Collection" asp-route-genreId="@Model.GenreId" asp-route-countryId="@Model.CountryId" asp-route-order="@Model.Order" asp-route-type="@Model.Type" asp-route-year="@Model.Year" asp-route-page="@(Model.FiltersResult.Page - 1)" asp-route-filtersPage="@(Model.FiltersResult.Page - 1)" class="rounded bg-slate-800 px-3 py-1.5 text-sm text-slate-300 hover:bg-amber-600 hover:text-slate-900">← Назад</a>
                            }
                            <span class="px-3 py-1.5 text-sm text-slate-400">@Model.FiltersResult.Page / @Model.FiltersResult.TotalPages</span>
                            @if (Model.FiltersResult.Page < Model.FiltersResult.TotalPages)
                            {
                                <a asp-page="/Index" asp-route-collection="@Model.Collection" asp-route-genreId="@Model.GenreId" asp-route-countryId="@Model.CountryId" asp-route-order="@Model.Order" asp-route-type="@Model.Type" asp-route-year="@Model.Year" asp-route-page="@(Model.FiltersResult.Page + 1)" asp-route-filtersPage="@(Model.FiltersResult.Page + 1)" class="rounded bg-slate-800 px-3 py-1.5 text-sm text-slate-300 hover:bg-amber-600 hover:text-slate-900">Вперёд →</a>
                            }
                        </div>
                    }
                }
            }
            else if (Model.CollectionResult != null)
            {
                <p class="mb-4 text-sm text-slate-400">Найдено: @Model.CollectionResult.Total · страница @Model.CollectionPage из @(Model.CollectionResult.TotalPages == 0 ? 1 : Model.CollectionResult.TotalPages)</p>
                @if (Model.CollectionResult.Items.Count == 0)
                {
                    <p class="text-slate-400">В этой подборке пока нет записей. Данные загружаются с Кинопоиска (API) — проверьте <code class="rounded bg-slate-800 px-1">KinopoiskApiKey</code> в appsettings.json и квоту на <a href="https://kinopoiskapiunofficial.tech" target="_blank" rel="noopener" class="text-amber-400 hover:underline">kinopoiskapiunofficial.tech</a>.</p>
                }
                else
                {
                    <ul class="max-w-2xl space-y-4">
                        @foreach (var item in Model.CollectionResult.Items)
                        {
                            <li class="flex gap-3 rounded-xl border border-slate-800 bg-slate-900/60 p-3">
                                <div class="w-28 shrink-0 sm:w-36">
                                    <a href="@Model.GetMovieUrlByKinopoiskId(item.KinopoiskId)" class="block">
                                        <div class="relative aspect-[2/3] overflow-hidden rounded-lg bg-slate-800">
                                            @if (!string.IsNullOrEmpty(item.PosterUrl) || !string.IsNullOrEmpty(item.PosterUrlPreview))
                                            {
                                                <img src="@PosterUrl(item.PosterUrl ?? item.PosterUrlPreview ?? "")" alt="@CollectionItemTitle(item)" class="h-full w-full object-cover transition hover:brightness-110" loading="lazy" />
                                            }
                                            else
                                            {
                                                <div class="flex h-full w-full items-center justify-center text-slate-500 text-xs">Нет постера</div>
                                            }
                                            @if (item.Type == "TV_SERIES" || (item.Type != null && item.Type.Contains("SERIES", StringComparison.OrdinalIgnoreCase)))
                                            {
                                                <span class="absolute bottom-0 left-0 right-0 bg-slate-900/90 px-2 py-1 text-center text-xs text-amber-300">Сериал</span>
                                            }
                                        </div>
                                    </a>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <a href="@Model.GetMovieUrlByKinopoiskId(item.KinopoiskId)" class="hover:text-amber-300">
                                        <h3 class="text-base font-semibold text-slate-100">@CollectionItemTitle(item) @(YearStr(item) != "" ? "(" + YearStr(item) + ")" : "")</h3>
                                    </a>
                                    <p class="mt-0.5 flex items-center gap-2 text-sm text-amber-400">
                                        <span>★</span>
                                        <span>@item.RatingKinopoisk.ToString("F1")</span>
                                        <span class="text-slate-500">/ 10</span>
                                    </p>
                                    <dl class="mt-2 grid gap-1 text-sm sm:grid-cols-1">
                                        @if (YearStr(item) != "")
                                        {
                                            <div class="flex gap-2"><dt class="text-slate-500 shrink-0">Год:</dt><dd class="text-slate-300">@YearStr(item)</dd></div>
                                        }
                                        @if (CountriesStr(item) != "")
                                        {
                                            <div class="flex gap-2"><dt class="text-slate-500 shrink-0">Страна:</dt><dd class="text-slate-300">@CountriesStr(item)</dd></div>
                                        }
                                        @if (GenresStr(item) != "")
                                        {
                                            <div class="flex gap-2"><dt class="text-slate-500 shrink-0">Жанр:</dt><dd class="text-slate-300">@GenresStr(item)</dd></div>
                                        }
                                    </dl>
                                    <div class="mt-3">
                                        <a href="@Model.GetMovieUrlByKinopoiskId(item.KinopoiskId)" class="inline-block rounded-lg bg-amber-600 px-3 py-1.5 text-sm font-medium text-slate-900 hover:bg-amber-500">Смотреть онлайн</a>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                    @if (Model.CollectionResult.TotalPages > 1)
                    {
                        <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
                            @if (Model.CollectionPage > 1)
                            {
                                <a asp-page="/Index" asp-route-collection="@Model.Collection" asp-route-page="@(Model.CollectionPage - 1)" class="rounded bg-slate-800 px-3 py-1.5 text-sm text-slate-300 hover:bg-amber-600 hover:text-slate-900">← Назад</a>
                            }
                            <span class="px-3 py-1.5 text-sm text-slate-400">@Model.CollectionPage / @Model.CollectionResult.TotalPages</span>
                            @if (Model.CollectionPage < Model.CollectionResult.TotalPages)
                            {
                                <a asp-page="/Index" asp-route-collection="@Model.Collection" asp-route-page="@(Model.CollectionPage + 1)" class="rounded bg-slate-800 px-3 py-1.5 text-sm text-slate-300 hover:bg-amber-600 hover:text-slate-900">Вперёд →</a>
                            }
                        </div>
                    }
                }
            }
            else
            {
                <p class="text-xs text-slate-500">KinoVibe — kinovibe</p>
            }
        </div>
    </section>

    @* Кинопремьеры — после каталога, на всю ширину *@
    @if (Model.Premieres.Count > 0)
    {
        <section class="border-t border-slate-800 px-3 py-6 sm:px-4">
            <h2 class="mb-4 text-lg font-semibold text-slate-200">Кинопремьеры</h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
                @foreach (var item in Model.Premieres)
                {
                    <a href="@Model.GetMovieUrlByKinopoiskId(item.KinopoiskId)" class="group flex flex-col rounded-lg border border-slate-700/80 bg-slate-800/60 overflow-hidden transition hover:border-amber-500/50 hover:bg-slate-800">
                        <div class="aspect-[2/3] w-full overflow-hidden rounded-t-lg bg-slate-700">
                            @if (!string.IsNullOrEmpty(item.PosterUrl))
                            {
                                <img src="@PremierePosterUrl(item.PosterUrl)" alt="@FeaturedTitle(item)" class="h-full w-full object-cover" loading="lazy" />
                            }
                            else
                            {
                                <div class="flex h-full w-full items-center justify-center text-slate-500 text-xs">Нет</div>
                            }
                        </div>
                        <div class="min-w-0 p-2">
                            <p class="line-clamp-2 text-xs font-medium text-slate-200 group-hover:text-amber-200">@FeaturedTitle(item)</p>
                            @if (!string.IsNullOrEmpty(item.PremiereRu))
                            {
                                <p class="text-[10px] text-slate-500">@item.PremiereRu</p>
                            }
                            else if (item.Year.HasValue)
                            {
                                <p class="text-[10px] text-slate-500">@item.Year</p>
                            }
                        </div>
                    </a>
                }
            </div>
        </section>
    }
</div>
