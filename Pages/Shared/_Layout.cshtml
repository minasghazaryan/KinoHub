@inject IConfiguration Configuration
@{
    var vibixEnableUnionAds = Configuration.GetValue<bool>("Vibix:EnableUnionAds");
    var vibixPublisherId = Configuration["Vibix:PublisherId"]?.Trim();
    var vibixUnionAdTypes = Configuration["Vibix:UnionAdTypes"]?.Trim();
    var vibixFlyrollPositionRaw = Configuration["Vibix:FlyrollPosition"]?.Trim();

    var vibixUnionEnabled = vibixEnableUnionAds && !string.IsNullOrEmpty(vibixPublisherId);
    var vibixUnionAdTypesSafe = string.IsNullOrEmpty(vibixUnionAdTypes) ? "flyroll" : vibixUnionAdTypes;
    var validFlyrollPositions = new[] { "1", "2", "3", "4" };
    var vibixFlyrollPositionSafe = !string.IsNullOrEmpty(vibixFlyrollPositionRaw) && validFlyrollPositions.Contains(vibixFlyrollPositionRaw)
        ? vibixFlyrollPositionRaw
        : null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/kinovibe_favicon_32x32.ico" type="image/x-icon" />
    <title>@ViewData["Title"] - KinoVibe</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100">
    @if (vibixUnionEnabled)
    {
        <ins id="vibix_union"
             data-publisher_id="@vibixPublisherId"
             data-add_types="@vibixUnionAdTypesSafe"
             @if (vibixFlyrollPositionSafe != null) { <text> data-position="@vibixFlyrollPositionSafe"</text> }></ins>
        <script type="text/javascript" src="https://v-js-menu.run/public/lib.en.min.js"></script>
    }
    <header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-900/95 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3">
            <a class="text-xl font-bold tracking-tight text-amber-400" asp-page="/Index">KINOVIBE</a>
            <div class="flex flex-1 items-center justify-end gap-3 sm:max-w-md">
                <form method="get" asp-page="/Index" class="flex flex-1 gap-1" role="search">
                    <input type="search" name="q" value="@ViewData["SearchQuery"]" placeholder="Поиск..." class="w-full rounded border border-slate-700 bg-slate-800 px-3 py-1.5 text-sm text-slate-100 placeholder-slate-500 focus:border-amber-500 focus:outline-none" />
                    <button type="submit" class="rounded bg-amber-600 px-3 py-1.5 text-sm font-medium text-slate-900 hover:bg-amber-500">OK</button>
                </form>
            </div>
            <a href="#" class="whitespace-nowrap text-sm text-slate-300 hover:text-amber-300">Вход / Регистрация</a>
        </div>
        <nav class="border-t border-slate-800">
            @{
                var navCollection = ViewData["Collection"] as string;
            }
            <div class="mx-auto flex max-w-7xl justify-center gap-1 px-4 py-2">
                <a asp-page="/Index" class="rounded px-4 py-2 text-sm font-medium @(string.IsNullOrEmpty(navCollection) ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">ГЛАВНАЯ</a>
                <a asp-page="/Index" asp-route-collection="TOP_POPULAR_ALL" class="rounded px-4 py-2 text-sm font-medium @(navCollection == "TOP_POPULAR_ALL" ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">НОВИНКИ</a>
                <a asp-page="/Index" asp-route-collection="POPULAR_SERIES" class="rounded px-4 py-2 text-sm font-medium @(navCollection == "POPULAR_SERIES" ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">СЕРИАЛЫ</a>
                <a asp-page="/Index" asp-route-collection="ANIME" class="rounded px-4 py-2 text-sm font-medium @(navCollection == "ANIME" ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">АНИМЕ</a>
                <a asp-page="/Index" asp-route-collection="KIDS_ANIMATION_THEME" class="rounded px-4 py-2 text-sm font-medium @(navCollection == "KIDS_ANIMATION_THEME" ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">МУЛЬТФИЛМЫ</a>
            </div>
        </nav>
    </header>
    <main role="main" class="min-h-screen">
        @if (vibixUnionEnabled && vibixUnionAdTypesSafe.Contains("banners", StringComparison.OrdinalIgnoreCase))
        {
            <div class="mx-auto max-w-7xl px-4 py-2 flex justify-center">
                <ins data-pa-b="300x250"></ins>
            </div>
        }
        @RenderBody()
    </main>
    <script src="https://graphicslab.io/sdk/v2/rendex-sdk.min.js"></script>
    <footer class="border-t border-slate-800 bg-slate-950 text-slate-500">
        <div class="mx-auto max-w-7xl px-4 py-6 text-center text-xs">KinoVibe &copy; @DateTime.UtcNow.Year</div>
    </footer>
</body>
</html>
