@inject IConfiguration Configuration
@{
    var vibixEnableUnionAds = Configuration.GetValue("Vibix:EnableUnionAds", true);
    var vibixPublisherId = Configuration["Vibix:PublisherId"]?.Trim();
    var vibixUnionAdTypes = Configuration["Vibix:UnionAdTypes"]?.Trim();
    var vibixFlyrollPositionRaw = Configuration["Vibix:FlyrollPosition"]?.Trim();

    var vibixUnionEnabled = !string.IsNullOrEmpty(vibixPublisherId) && vibixEnableUnionAds;
    var vibixUnionAdTypesSafe = string.IsNullOrEmpty(vibixUnionAdTypes) ? "sticker" : vibixUnionAdTypes;
    var validFlyrollPositions = new[] { "1", "2", "3", "4" };
    var vibixFlyrollPositionSafe = !string.IsNullOrEmpty(vibixFlyrollPositionRaw) && validFlyrollPositions.Contains(vibixFlyrollPositionRaw)
        ? vibixFlyrollPositionRaw
        : "1";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="~/kinovibe_favicon_32x32.ico" type="image/x-icon" />
    <title>@ViewData["Title"] - KinoVibe</title>
    <link rel="stylesheet" href="~/css/tailwind.css" />
    <style>
        /* Branded scrollbars: slate track + amber thumb (years, genres, and all scrollable areas) */
        /* Firefox */
        select, [class*="overflow-auto"], [class*="overflow-y-auto"], .overflow-x-auto { scrollbar-width: thin; scrollbar-color: #f59e0b #1e293b; }
        /* WebKit (Chrome, Edge, Safari) */
        select::-webkit-scrollbar, [class*="overflow-auto"]::-webkit-scrollbar, [class*="overflow-y-auto"]::-webkit-scrollbar, .overflow-x-auto::-webkit-scrollbar { width: 8px; height: 8px; }
        select::-webkit-scrollbar-track, [class*="overflow-auto"]::-webkit-scrollbar-track, [class*="overflow-y-auto"]::-webkit-scrollbar-track, .overflow-x-auto::-webkit-scrollbar-track { background: #1e293b; border-radius: 4px; }
        select::-webkit-scrollbar-thumb, [class*="overflow-auto"]::-webkit-scrollbar-thumb, [class*="overflow-y-auto"]::-webkit-scrollbar-thumb, .overflow-x-auto::-webkit-scrollbar-thumb { background: #f59e0b; border-radius: 4px; }
        select::-webkit-scrollbar-thumb:hover, [class*="overflow-auto"]::-webkit-scrollbar-thumb:hover, [class*="overflow-y-auto"]::-webkit-scrollbar-thumb:hover, .overflow-x-auto::-webkit-scrollbar-thumb:hover { background: #d97706; }
        #header-search-shell { width: 100%; max-width: 100%; }
        @@media (min-width: 768px) {
            #header-topbar { position: relative; }
            #header-search-shell { width: 450px; max-width: 450px; }
            #header-search-shell {
                position: absolute;
                left: 50%;
                transform: translateX(-50%);
            }
        }
    </style>
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript">
        (function(m,e,t,r,i,k,a){
            m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
            m[i].l=1*new Date();
            for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
            k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)
        })(window, document,'script','https://mc.yandex.ru/metrika/tag.js?id=106991484', 'ym');

        ym(106991484, 'init', {ssr:true, webvisor:true, clickmap:true, ecommerce:"dataLayer", referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/106991484" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
</head>
<body class="bg-slate-950 text-slate-100">
    @if (vibixUnionEnabled)
    {
        <ins id="vibix_union"
             data-publisher_id="@vibixPublisherId"
             data-add_types="@vibixUnionAdTypesSafe"
             data-position="@vibixFlyrollPositionSafe"></ins>
        <script type="text/javascript" src="https://v-js-menu.run/public/lib.en.min.js"></script>
    }
    <header class="sticky top-0 z-50 border-b border-slate-800 bg-slate-900/95 backdrop-blur">
        <div id="header-topbar" class="mx-auto flex max-w-7xl flex-col gap-3 px-3 py-3 sm:flex-row sm:items-center sm:gap-0 sm:px-4">
            <div class="min-w-0 shrink-0 sm:flex-1">
                <a class="text-lg font-bold tracking-tight text-amber-400 sm:text-xl" asp-page="/Index">KINOVIBE</a>
            </div>
            <div id="header-search-shell" class="w-full min-w-0 shrink-0">
                <form id="header-search-form" method="get" asp-page="/Index" class="flex w-full gap-2" role="search">
                    <div class="relative min-w-0 flex-1">
                        <input id="header-search-input" type="search" name="q" value="@ViewData["SearchQuery"]" placeholder="Поиск..." class="w-full rounded border border-slate-700 bg-slate-800 px-2.5 py-1 text-sm text-slate-100 placeholder-slate-500 focus:border-amber-500 focus:outline-none" autocomplete="off" />
                        <div id="header-search-dropdown" class="absolute left-0 right-0 top-full z-50 mt-1 hidden max-h-64 overflow-auto rounded-lg border border-slate-700 shadow-xl" style="background-color: #0f172a;" role="listbox"></div>
                    </div>
                    <button type="submit" class="shrink-0 rounded bg-amber-600 px-2.5 py-1 text-sm font-medium text-slate-900 hover:bg-amber-500">OK</button>
                </form>
            </div>
            <div class="min-w-0 flex-1"></div>
        </div>
        <script>
            (function () {
                var form = document.getElementById('header-search-form');
                var input = document.getElementById('header-search-input');
                var dropdown = document.getElementById('header-search-dropdown');
                if (!form || !input || !dropdown) return;
                var debounceTimer;
                var minChars = 2;
                var hideTimer;
                function hideDropdown() { hideTimer = setTimeout(function () { dropdown.classList.add('hidden'); }, 150); }
                function showDropdown() { clearTimeout(hideTimer); dropdown.classList.remove('hidden'); }
                function buildSuggestionsUrl(q) {
                    var url = new URL(form.action || '/Index', window.location.origin);
                    url.searchParams.set('handler', 'SearchSuggestions');
                    url.searchParams.set('q', q);
                    return url.toString();
                }
                function renderSuggestions(items) {
                    dropdown.innerHTML = '';
                    if (!items || items.length === 0) { dropdown.classList.add('hidden'); return; }
                    items.forEach(function (item) {
                        var a = document.createElement('a');
                        a.href = item.url || ('/Details?id=' + encodeURIComponent(item.id));
                        a.className = 'block border-b border-slate-700 px-3 py-2 text-sm text-slate-200 hover:bg-slate-800 first:rounded-t-lg last:border-b-0 last:rounded-b-lg';
                        a.textContent = (item.title || '') + (item.year ? ' (' + item.year + ')' : '');
                        a.setAttribute('role', 'option');
                        dropdown.appendChild(a);
                    });
                    showDropdown();
                }
                input.addEventListener('input', function () {
                    clearTimeout(debounceTimer);
                    var val = (input.value || '').trim();
                    if (val.length < minChars) { dropdown.classList.add('hidden'); dropdown.innerHTML = ''; return; }
                    debounceTimer = setTimeout(function () {
                        fetch(buildSuggestionsUrl(val)).then(function (r) { return r.json(); }).then(renderSuggestions).catch(function () { renderSuggestions([]); });
                    }, 300);
                });
                input.addEventListener('focus', function () { if (dropdown.children.length > 0) showDropdown(); });
                input.addEventListener('blur', hideDropdown);
                dropdown.addEventListener('mousedown', function (e) { e.preventDefault(); });
                form.addEventListener('submit', function () { dropdown.classList.add('hidden'); });
            })();
        </script>
        <nav class="border-t border-slate-800">
            @{
                var navCollection = ViewData["Collection"] as string;
            }
            <div class="mx-auto flex max-w-7xl flex-wrap justify-center gap-1 px-2 py-2 sm:px-4">
                <a asp-page="/Index" class="rounded px-2 py-1.5 text-xs font-medium sm:px-4 sm:py-2 sm:text-sm @(string.IsNullOrEmpty(navCollection) ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">ГЛАВНАЯ</a>
                <a asp-page="/Index" asp-route-collection="TOP_POPULAR_ALL" class="rounded px-2 py-1.5 text-xs font-medium sm:px-4 sm:py-2 sm:text-sm @(navCollection == "TOP_POPULAR_ALL" ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">НОВИНКИ</a>
                <a asp-page="/Index" asp-route-collection="POPULAR_SERIES" class="rounded px-2 py-1.5 text-xs font-medium sm:px-4 sm:py-2 sm:text-sm @(navCollection == "POPULAR_SERIES" ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">СЕРИАЛЫ</a>
                <a asp-page="/Index" asp-route-collection="ANIME" class="rounded px-2 py-1.5 text-xs font-medium sm:px-4 sm:py-2 sm:text-sm @(navCollection == "ANIME" ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">АНИМЕ</a>
                <a asp-page="/Index" asp-route-collection="KIDS_ANIMATION_THEME" class="rounded px-2 py-1.5 text-xs font-medium sm:px-4 sm:py-2 sm:text-sm @(navCollection == "KIDS_ANIMATION_THEME" ? "bg-amber-400/10 text-amber-400" : "text-slate-400 hover:bg-slate-800 hover:text-slate-100")">МУЛЬТФИЛМЫ</a>
            </div>
        </nav>
    </header>
    <main role="main" class="min-h-screen">
        @RenderBody()
    </main>
    <footer class="border-t border-slate-800 bg-slate-950 text-slate-500">
        <div class="mx-auto max-w-7xl px-4 py-6 text-center text-xs">KinoVibe &copy; @DateTime.UtcNow.Year</div>
    </footer>
</body>
</html>
