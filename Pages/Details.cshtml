@page
@model KinoHub.Web.Pages.DetailsModel
@{
    ViewData["Title"] = Model.FilmDetails != null
        ? (Model.FilmDetails.NameRu ?? Model.FilmDetails.NameEn ?? "Детали фильма")
        : "Детали фильма";

    string PosterUrl(string? path) => string.IsNullOrEmpty(path) ? "" : (path.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? path : "https://image.tmdb.org/t/p/w500" + path);
    string DisplayTitle() => Model.FilmDetails?.NameRu ?? Model.FilmDetails?.NameEn ?? "Без названия";
    string? CountriesStr() => Model.FilmDetails?.Countries != null && Model.FilmDetails.Countries.Count > 0
        ? string.Join(", ", Model.FilmDetails.Countries.Select(c => c.Country).Where(c => !string.IsNullOrEmpty(c)))
        : null;
    string? GenresStr() => Model.FilmDetails?.Genres != null && Model.FilmDetails.Genres.Count > 0
        ? string.Join(", ", Model.FilmDetails.Genres.Select(g => g.Genre).Where(g => !string.IsNullOrEmpty(g)))
        : null;
    string? DurationStr() => Model.FilmDetails?.FilmLength is > 0 ? $"{Model.FilmDetails.FilmLength} мин." : null;
    string? YearRangeStr() => Model.FilmDetails?.StartYear is > 0 && Model.FilmDetails?.EndYear is > 0
        ? (Model.FilmDetails.StartYear == Model.FilmDetails.EndYear ? $"{Model.FilmDetails.StartYear}" : $"{Model.FilmDetails.StartYear} – {Model.FilmDetails.EndYear}")
        : (Model.FilmDetails?.Year > 0 ? $"{Model.FilmDetails.Year}" : null);
}

<div class="mx-auto max-w-6xl px-3 py-4 sm:px-4 sm:py-6">
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="rounded-xl border border-red-800 bg-red-900/20 p-6 text-red-300">
            <p>@Model.ErrorMessage</p>
            <a asp-page="/Index" class="mt-4 inline-block text-amber-400 hover:underline">← Вернуться на главную</a>
        </div>
    }
    else if (Model.FilmDetails == null)
    {
        <div class="rounded-xl border border-slate-800 bg-slate-900/60 p-6 text-slate-400">
            <p>Загрузка...</p>
        </div>
    }
    else
    {
        @* Title: main + English (like reference) *@
        <h1 class="mb-1 text-2xl font-bold text-slate-100 md:text-3xl">@DisplayTitle()</h1>
        @if (!string.IsNullOrEmpty(Model.FilmDetails!.NameEn) && Model.FilmDetails.NameEn != Model.FilmDetails.NameRu)
        {
            <p class="mb-4 text-base text-slate-400">@Model.FilmDetails.NameEn</p>
        }
        else
        {
            <div class="mb-4"></div>
        }

        @* Poster + metadata row (reference layout) *@
        <div class="flex flex-col gap-5 lg:flex-row">
            @* Left: poster + Смотреть трейлер *@
            <div class="shrink-0 lg:w-72">
                <div class="relative aspect-[2/3] overflow-hidden rounded-xl bg-slate-800 shadow-xl">
                    @if (!string.IsNullOrEmpty(Model.FilmDetails.PosterUrl) || !string.IsNullOrEmpty(Model.FilmDetails.PosterUrlPreview))
                    {
                        <img src="@PosterUrl(Model.FilmDetails.PosterUrl ?? Model.FilmDetails.PosterUrlPreview)" alt="@DisplayTitle()" class="h-full w-full object-cover" />
                    }
                    else
                    {
                        <div class="flex h-full w-full items-center justify-center text-slate-500">Нет постера</div>
                    }
                    @if (Model.IsSeries)
                    {
                        <span class="absolute top-3 right-3 rounded-lg bg-amber-600 px-2.5 py-1 text-xs font-semibold text-slate-900">СЕРИАЛ</span>
                    }
                </div>
                @{
                    var videosWithUrl = Model.Videos?.Items?.Where(v => !string.IsNullOrEmpty(v.Url)).ToList() ?? [];
                    var firstVideo = videosWithUrl.Count > 1
                        ? (videosWithUrl.FirstOrDefault(v => string.Equals(v.Name?.Trim(), "Русский", StringComparison.OrdinalIgnoreCase)) ?? videosWithUrl.FirstOrDefault())
                        : videosWithUrl.FirstOrDefault();
                }
                @if (firstVideo != null)
                {
                    <a href="@firstVideo.Url" target="_blank" rel="noopener noreferrer" class="mt-3 flex w-full items-center justify-center gap-2 rounded-xl border border-slate-600 bg-slate-800/80 py-2.5 text-sm text-slate-200 transition hover:bg-slate-700 hover:text-white">
                        <svg class="h-5 w-5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M6.3 2.84A1.5 1.5 0 014 4v12a1.5 1.5 0 012.3 1.16l9-6a1.5 1.5 0 000-2.32l-9-6z"/></svg>
                        <span>Смотреть трейлер</span>
                    </a>
                }
            </div>

            @* Right: metadata in reference order *@
            <div class="min-w-0 flex-1" style="padding-left:12px">
                <dl class="space-y-2 text-[13px] leading-5">
                    @* Рейтинги: IMDb first, then Кинопоиск (with votes) *@
                    @if (Model.FilmDetails.RatingImdb > 0 || Model.FilmDetails.RatingKinopoisk > 0)
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Рейтинги:</dt>
                            <dd class="text-slate-200">
                                @if (Model.FilmDetails.RatingImdb > 0)
                                {
                                    <span>IMDb: @Model.FilmDetails.RatingImdb.ToString("F1")@(Model.FilmDetails.RatingImdbVoteCount > 0 ? $" ({Model.FilmDetails.RatingImdbVoteCount:N0})" : "")</span>
                                }
                                @if (Model.FilmDetails.RatingImdb > 0 && Model.FilmDetails.RatingKinopoisk > 0) { <span class="text-slate-500"> · </span> }
                                @if (Model.FilmDetails.RatingKinopoisk > 0)
                                {
                                    <span>Кинопоиск: @Model.FilmDetails.RatingKinopoisk.ToString("F2")@(Model.FilmDetails.RatingKinopoiskVoteCount > 0 ? $" ({Model.FilmDetails.RatingKinopoiskVoteCount:N0})" : "")</span>
                                }
                            </dd>
                        </div>
                    }
                    @* Слоган *@
                    @if (!string.IsNullOrWhiteSpace(Model.FilmDetails.Slogan))
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Слоган:</dt>
                            <dd class="italic text-slate-300">«@Model.FilmDetails.Slogan»</dd>
                        </div>
                    }
                    @* Дата выхода *@
                    @if (Model.FilmDetails.Year > 0 || YearRangeStr() != null)
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Дата выхода:</dt>
                            <dd class="text-slate-200">@(YearRangeStr() ?? Model.FilmDetails.Year.ToString())@(YearRangeStr() == null && Model.FilmDetails.Year > 0 ? " года" : "")</dd>
                        </div>
                    }
                    @* Страна *@
                    @if (CountriesStr() != null)
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Страна:</dt>
                            <dd class="text-slate-200">@CountriesStr()</dd>
                        </div>
                    }
                    @* Режиссер *@
                    @{
                        var directors = Model.Staff?.Where(s => string.Equals(s.ProfessionKey, "DIRECTOR", StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
                    }
                    @if (directors.Count > 0)
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Режиссер:</dt>
                            <dd class="text-slate-200">@string.Join(", ", directors.Select(d => d.NameRu ?? d.NameEn ?? "").Where(n => !string.IsNullOrEmpty(n)))</dd>
                        </div>
                    }
                    @* Жанр *@
                    @if (GenresStr() != null)
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Жанр:</dt>
                            <dd class="text-slate-200">@GenresStr()</dd>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.VibixVideo?.Quality))
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Качество:</dt>
                            <dd class="text-slate-200">@Model.VibixVideo.Quality</dd>
                        </div>
                    }
                    @* @if (Model.VoiceoversList.Count > 0)
                    {
                        <div>
                            <dt class="mb-1 text-slate-500">Озвучка:</dt>
                            <dd class="text-slate-200">@string.Join(", ", Model.VoiceoversList.Select(v => v.Name).Where(n => !string.IsNullOrWhiteSpace(n)))</dd>
                        </div>
                    } *@
                    @* Время *@
                    @if (DurationStr() != null)
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Время:</dt>
                            <dd class="text-slate-200">@DurationStr()</dd>
                        </div>
                    }
                    @* Возраст *@
                    @if (!string.IsNullOrEmpty(Model.FilmDetails.RatingAgeLimits))
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">Возраст:</dt>
                            <dd class="text-slate-200">@Model.FilmDetails.RatingAgeLimits</dd>
                        </div>
                    }
                    @* В ролях актеры *@
                    @{
                        var actors = Model.Staff?.Where(s => string.Equals(s.ProfessionKey, "ACTOR", StringComparison.OrdinalIgnoreCase)).Take(15).ToList() ?? [];
                    }
                    @if (actors.Count > 0)
                    {
                        <div>
                            <dt class="mb-0.5 text-slate-500">В ролях актеры:</dt>
                            <dd class="text-slate-200">@string.Join(", ", actors.Select(a => a.NameRu ?? a.NameEn ?? "").Where(n => !string.IsNullOrEmpty(n)))@(Model.Staff?.Count(s => string.Equals(s.ProfessionKey, "ACTOR", StringComparison.OrdinalIgnoreCase)) > 15 ? " и другие" : "")</dd>
                        </div>
                    }
                </dl>

            </div>
        </div>

        @* Про что фильм — full width (reference) *@
        @if (!string.IsNullOrWhiteSpace(Model.FilmDetails.Description) || !string.IsNullOrWhiteSpace(Model.FilmDetails.ShortDescription))
        {
            <div class="mt-8 border-t border-slate-800 pt-8">
                <h2 class="mb-3 text-lg font-semibold text-slate-200">Про что фильм «@DisplayTitle()»:</h2>
                <div class="text-slate-300 leading-relaxed whitespace-pre-line">@(Model.FilmDetails.Description ?? Model.FilmDetails.ShortDescription)</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.VibixVideo?.IframeUrl) || !string.IsNullOrWhiteSpace(Model.VibixVideo?.EmbedCode))
        {
            <div class="mt-8 border-t border-slate-800 pt-8">
                <h2 class="mb-2 text-xl font-semibold text-slate-100">@DisplayTitle() — смотреть онлайн</h2>
                @if (!string.IsNullOrWhiteSpace(Model.VibixVideo?.IframeUrl))
                {
                    <div class="relative aspect-video w-full overflow-hidden rounded-xl bg-black">
                        <iframe
                            src="@Model.VibixVideo.IframeUrl"
                            class="absolute inset-0 h-full w-full"
                            loading="lazy"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen
                            webkitallowfullscreen
                            mozallowfullscreen
                            allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
                            title="Плеер"></iframe>
                    </div>
                }
                else if (!string.IsNullOrWhiteSpace(Model.VibixVideo?.EmbedCode))
                {
                    <div class="prose prose-invert max-w-none overflow-hidden rounded-xl bg-slate-900/60 p-4">
                        @Html.Raw(Model.VibixVideo.EmbedCode)
                    </div>
                }
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(Model.VibixPublisherId) && Model.FilmDetails.KinopoiskId > 0)
        {
            var voiceoversForPlayer = Model.VoiceoversList ?? [];
            <div class="mt-8 border-t border-slate-800 pt-8">
                <h2 class="mb-2 text-xl font-semibold text-slate-100">@DisplayTitle() — смотреть онлайн</h2>
                <div class="vibix-player-wrap relative aspect-video w-full overflow-hidden rounded-xl bg-black">
                    <ins id="vibix-player-ins" class="block h-full w-full min-h-[360px]"
                         data-publisher-id="@Model.VibixPublisherId"
                         data-type="kp"
                         data-id="@Model.FilmDetails.KinopoiskId"
                         data-poster="true"
                         data-design="1"
                         @(voiceoversForPlayer.Count > 0 ? $"data-voiceover-id=\"{voiceoversForPlayer[0].Id}\"" : "")>
                    </ins>
                </div>
                <style>
                    .vibix-player-wrap ins,
                    .vibix-player-wrap iframe { position: absolute; inset: 0; width: 100%; height: 100%; min-height: 100%; }
                </style>
                <script src="https://graphicslab.io/sdk/v2/rendex-sdk.min.js"></script>
                @if (voiceoversForPlayer.Count > 0)
                {
                    <script>
                        (function() {
                            var sel = document.getElementById('vibix-voiceover-select');
                            var ins = document.getElementById('vibix-player-ins');
                            if (!sel || !ins) return;
                            sel.addEventListener('change', function() {
                                var id = this.value;
                                ins.setAttribute('data-voiceover-id', id);
                                if (window.RendexSDK && typeof window.RendexSDK.reload === 'function') {
                                    window.RendexSDK.reload();
                                }
                            });
                        })();
                    </script>
                }
            </div>
        }
        else if (Model.FilmDetails.KinopoiskId > 0)
        {
            <div class="mt-8 border-t border-slate-800 pt-8">
                <h2 class="mb-2 text-xl font-semibold text-slate-100">@DisplayTitle() — видео и трейлеры</h2>
                <p class="mb-4 text-sm text-slate-400">Плеер Vibix для этого фильма недоступен. Можно открыть трейлеры из Kinopoisk API.</p>
                <a asp-page="/Watch" asp-route-id="@Model.FilmDetails.KinopoiskId" class="inline-flex items-center rounded-lg bg-amber-600 px-4 py-2 text-sm font-medium text-slate-900 hover:bg-amber-500">
                    Открыть видео
                </a>
            </div>
        }

        @* 1. Похожие фильмы (Similars) *@
        @if (Model.Similars != null && Model.Similars.Items != null && Model.Similars.Items.Count > 0)
        {
            <div class="mt-8 border-t border-slate-800 pt-8">
                <h2 class="text-xl font-semibold text-slate-200">Похожие фильмы (@Model.Similars.Items.Count)</h2>
                <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
                    @foreach (var sim in Model.Similars.Items.Take(5))
                    {
                        <a asp-page="/Details" asp-route-id="@sim.FilmId" class="group flex flex-col">
                            <div class="aspect-[2/3] overflow-hidden rounded-xl bg-slate-800 shadow-md transition group-hover:ring-2 group-hover:ring-amber-500/50">
                                @if (!string.IsNullOrEmpty(sim.PosterUrlPreview ?? sim.PosterUrl))
                                {
                                    <img src="@(sim.PosterUrl ?? sim.PosterUrlPreview)" alt="" class="h-full w-full object-cover transition group-hover:scale-105" />
                                }
                                else
                                {
                                    <div class="flex h-full w-full items-center justify-center text-slate-500">Нет постера</div>
                                }
                            </div>
                            <span class="mt-2 line-clamp-2 text-sm font-medium text-slate-200 group-hover:text-amber-400">@(sim.NameRu ?? sim.NameEn ?? sim.NameOriginal ?? "—")</span>
                        </a>
                    }
                </div>
                @if (Model.Similars.Items.Count > 5) { <p class="mt-2 text-sm text-slate-500">Показано 5 из @Model.Similars.Total</p> }
            </div>
        }

        @* 2. Связанные фильмы (Relations) *@
        @if (Model.Relations != null && Model.Relations.Items != null && Model.Relations.Items.Count > 0)
        {
            <div class="mt-8 border-t border-slate-800 pt-8">
                <h2 class="text-xl font-semibold text-slate-200">Связанные фильмы (@Model.Relations.Items.Count)</h2>
                <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5">
                    @foreach (var rel in Model.Relations.Items.Take(5))
                    {
                        <a asp-page="/Details" asp-route-id="@rel.KinopoiskId" class="group flex flex-col">
                            <div class="aspect-[2/3] overflow-hidden rounded-xl bg-slate-800 shadow-md transition group-hover:ring-2 group-hover:ring-amber-500/50">
                                @if (!string.IsNullOrEmpty(rel.PosterUrlPreview ?? rel.PosterUrl))
                                {
                                    <img src="@(rel.PosterUrl ?? rel.PosterUrlPreview)" alt="" class="h-full w-full object-cover transition group-hover:scale-105" />
                                }
                                else
                                {
                                    <div class="flex h-full w-full items-center justify-center text-slate-500">Нет постера</div>
                                }
                            </div>
                            <span class="mt-2 line-clamp-2 text-sm font-medium text-slate-200 group-hover:text-amber-400">@(rel.NameRu ?? rel.NameEn ?? rel.NameOriginal ?? "—")</span>
                            @if (!string.IsNullOrEmpty(rel.RelationType))
                            {
                                <span class="mt-0.5 text-xs text-slate-500">@rel.RelationType</span>
                            }
                        </a>
                    }
                </div>
                @if (Model.Relations.Items.Count > 5) { <p class="mt-2 text-sm text-slate-500">Показано 5 из @Model.Relations.Total</p> }
            </div>
        }

        @* 3. Рецензии зрителей — top 10 + see more; each card 2–3 lines + read more *@
        @if (Model.Reviews != null && Model.Reviews.Items != null && Model.Reviews.Items.Count > 0)
        {
            var topReviews = Model.Reviews.Items.Take(10).ToList();
            var moreReviews = Model.Reviews.Items.Skip(10).ToList();
            <div class="mt-8 border-t border-slate-800 pt-8">
                <h2 class="text-xl font-semibold text-slate-200">Рецензии зрителей (@Model.Reviews.Total)</h2>
                <div class="mt-4">
                    <p class="mb-4 text-sm text-slate-400">
                        Положительных: @Model.Reviews.TotalPositiveReviews · Отрицательных: @Model.Reviews.TotalNegativeReviews · Нейтральных: @Model.Reviews.TotalNeutralReviews
                    </p>
                    <div class="space-y-4">
                        @foreach (var review in topReviews)
                        {
                            <div class="review-card rounded-xl border border-slate-800 bg-slate-900/60 p-4">
                                <div class="mb-2 flex flex-wrap items-center gap-2">
                                    <span class="rounded px-2 py-0.5 text-xs font-medium
                                        @(review.Type == "POSITIVE" ? "bg-emerald-900/50 text-emerald-300" : review.Type == "NEGATIVE" ? "bg-red-900/50 text-red-300" : "bg-slate-700 text-slate-400")">
                                        @(review.Type == "POSITIVE" ? "Положительная" : review.Type == "NEGATIVE" ? "Отрицательная" : "Нейтральная")
                                    </span>
                                    @if (!string.IsNullOrEmpty(review.Author))
                                    {
                                        <span class="text-sm font-medium text-slate-300">@review.Author</span>
                                    }
                                    @if (!string.IsNullOrEmpty(review.Date) && DateTime.TryParse(review.Date, out var reviewDate))
                                    {
                                        <span class="text-xs text-slate-500">@reviewDate.ToString("dd.MM.yyyy")</span>
                                    }
                                    <span class="text-xs text-slate-500">👍 @review.PositiveRating · 👎 @review.NegativeRating</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(review.Title))
                                {
                                    <h4 class="mb-1 text-sm font-semibold text-slate-200">@review.Title</h4>
                                }
                                @if (!string.IsNullOrWhiteSpace(review.Description))
                                {
                                    <div class="review-text-wrapper">
                                        <p class="review-text text-sm text-slate-300 leading-relaxed whitespace-pre-line line-clamp-3">@review.Description</p>
                                        <button type="button" class="review-read-more mt-1 text-sm text-amber-400 hover:text-amber-300">Читать далее</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @if (moreReviews.Count > 0)
                    {
                        <div id="reviews-more" class="hidden space-y-4 mt-4">
                            @foreach (var review in moreReviews)
                            {
                                <div class="review-card rounded-xl border border-slate-800 bg-slate-900/60 p-4">
                                    <div class="mb-2 flex flex-wrap items-center gap-2">
                                        <span class="rounded px-2 py-0.5 text-xs font-medium
                                            @(review.Type == "POSITIVE" ? "bg-emerald-900/50 text-emerald-300" : review.Type == "NEGATIVE" ? "bg-red-900/50 text-red-300" : "bg-slate-700 text-slate-400")">
                                            @(review.Type == "POSITIVE" ? "Положительная" : review.Type == "NEGATIVE" ? "Отрицательная" : "Нейтральная")
                                        </span>
                                        @if (!string.IsNullOrEmpty(review.Author))
                                        {
                                            <span class="text-sm font-medium text-slate-300">@review.Author</span>
                                        }
                                        @if (!string.IsNullOrEmpty(review.Date) && DateTime.TryParse(review.Date, out var rd))
                                        {
                                            <span class="text-xs text-slate-500">@rd.ToString("dd.MM.yyyy")</span>
                                        }
                                        <span class="text-xs text-slate-500">👍 @review.PositiveRating · 👎 @review.NegativeRating</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(review.Title))
                                    {
                                        <h4 class="mb-1 text-sm font-semibold text-slate-200">@review.Title</h4>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(review.Description))
                                    {
                                        <div class="review-text-wrapper">
                                            <p class="review-text text-sm text-slate-300 leading-relaxed whitespace-pre-line line-clamp-3">@review.Description</p>
                                            <button type="button" class="review-read-more mt-1 text-sm text-amber-400 hover:text-amber-300">Читать далее</button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <button type="button" id="reviews-see-more" class="mt-4 rounded-lg border border-slate-600 bg-slate-800 px-4 py-2 text-sm font-medium text-slate-200 hover:bg-slate-700">Показать ещё (@moreReviews.Count)</button>
                    }
                    @if (Model.Reviews.TotalPages > 1)
                    {
                        <p class="mt-3 text-sm text-slate-500">Страница 1 из @Model.Reviews.TotalPages</p>
                    }
                </div>
            </div>
            <script>
                (function() {
                    document.getElementById('reviews-see-more')?.addEventListener('click', function() {
                        var el = document.getElementById('reviews-more');
                        if (el) { el.classList.remove('hidden'); this.classList.add('hidden'); }
                    });
                    document.querySelectorAll('.review-read-more').forEach(function(btn) {
                        btn.addEventListener('click', function() {
                            var wrap = this.closest('.review-text-wrapper');
                            if (!wrap) return;
                            var p = wrap.querySelector('.review-text');
                            if (p) p.classList.remove('line-clamp-3');
                            this.remove();
                        });
                    });
                })();
            </script>
        }
    }
</div>
